# Inlined into the browser bundle by `next build`: in Docker, pass it as a build arg.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Session signing key, generate with: openssl rand -base64 32
AUTH_SECRET=

# `next dev` trusts localhost implicitly, but a production build rejects the Host
# header unless told the proxy in front of it is trustworthy. Without this, sign-in
# fails with UntrustedHost. Set AUTH_URL to the canonical public URL instead when
# the app is reachable directly rather than through a proxy.
AUTH_TRUST_HOST=true

# Required for the Docker image: the standalone server binds to 0.0.0.0 and Auth.js
# would build its callback URLs from that host. Use the public URL of the console.
# AUTH_URL=https://console.example.com

# GitHub OAuth app (optional): with these unset, only the demo login is offered.
# Callback URL: http://localhost:3001/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated emails granted the operator role (they may replay dead letters).
# A GitHub account outside this list is refused.
AUTH_OPERATOR_EMAILS=

# Read-only demo account. Generate the hash with: pnpm --filter @conveyor/web hash-password
DEMO_EMAIL=demo@conveyor.dev
DEMO_PASSWORD_HASH=

# The console proxies write requests to the API server-side; both sides must
# carry the same secret (mirrors SERVICE_TOKEN in apps/api).
API_URL=http://localhost:3000
API_SERVICE_TOKEN=
